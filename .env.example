# Required. Use a pooled PostgreSQL URL from your provider for Vercel.
# Retain the provider's TLS parameters. Never disable certificate validation.
DATABASE_URL=postgresql://cubic_chess:local-development-only@127.0.0.1:5432/cubic_chess
# Required, minimum 12 characters; choose your own password.
SITE_PASSWORD=
# Required, minimum 32 characters; generate: openssl rand -hex 32
SESSION_SECRET=
# Separate disposable test database. Integration tests DELETE all its game data.
TEST_DATABASE_URL=postgresql://cubic_chess:local-development-only@127.0.0.1:5432/cubic_chess_test
# Optional local development port (binds to loopback only).
PORT=3000
